# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Local runtime data (postgres/ipfs docker volumes)
data/

# Dotenv files — match every variant (.env.local, .env.bak-*, .env.production …)
# so a stray copy of a file holding PRIVATE_KEY can never be committed.
.env
.env.*
!.env.example

# ─── RWA Real Estate — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in the values before running any scripts.
# Never commit the populated .env file to version control.

# ── Network / Wallet ────────────────────────────────────────────────────────

# RPC endpoint for the target network.
# Also used by docker-compose graph-node (ethereum: sepolia:${RPC_URL})
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployer private key — 32-byte hex WITH 0x prefix
# e.g. 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=0xYourPrivateKeyHere

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Governance (DeployGovernance.s.sol) ─────────────────────────────────────

# Address of the multisig wallet that will be the sole proposer on the
# TimelockController (e.g. Gnosis Safe).
# → Create one at https://safe.global → New Safe → Sepolia
# → For solo dev testing, use your own deployer wallet address.
MULTISIG_ADDRESS=0xYourMultisigAddressHere

# Minimum timelock delay in seconds.
# Production: 172800 = 48 hours | Sepolia testing: 60 = 1 minute
TIMELOCK_DELAY=172800

# ── Core (DeployCore.s.sol) ─────────────────────────────────────────────────

# Address of the ERC-20 token used for rent payments and marketplace trades.
# Sepolia USDC (Circle official): 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Local Hardhat: deploy MockERC20 first, paste address here.
PAYMENT_TOKEN=0xUsdcOrPaymentTokenAddressHere

# Address of the TimelockController deployed by DeployGovernance.s.sol.
# !! Fill this in AFTER running step 1 (DeployGovernance) !!
# The deploy script prints: "TimelockController : 0x..."
TIMELOCK_ADDRESS=0xTimelockControllerAddressHere

# Address that receives Marketplace protocol fees (0.5% of secondary volume).
# Optional — defaults to TIMELOCK_ADDRESS if unset.
# Do NOT use the deployer EOA: DeployCore renounces all deployer roles, so fees
# would accrue to a key with no governance standing.
TREASURY_ADDRESS=0xTreasuryOrTimelockAddressHere

# ── Off-chain media index (frontend/.env.local) ──────────────────────────────
# Atlas connection string: Atlas -> Connect -> Drivers -> Node.js.
# Percent-encode any of @ : / ? # & % appearing in the password.
# The cluster's IP allowlist must include your address (Atlas -> Network Access).
MONGODB_URI=
# Database holding the propertyMedia collection. Defaults to RealEstate.
MONGODB_DB=
